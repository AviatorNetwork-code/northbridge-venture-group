# NEO provider configuration
# mock = local mock data (default)
# local = connect to a local NEO service with mock fallback
NEXT_PUBLIC_NEO_PROVIDER=mock
# Live retrieve base URL (required for live Nordy → NEO retrieval). Without it,
# Nordy safely falls back to @northbridge/platform-ai mock completion.
# NEXT_PUBLIC_NEO_BASE_URL=https://neo.example.internal

# Production CAP-LEARN emit is gated OFF by default. Founder-only.
# NORDY_PRODUCTION_LEARNING_EMIT=true

# Founder account emails (comma-separated) for Conversation Learning founder controls
NEXT_PUBLIC_NORDI_FOUNDER_EMAILS=
